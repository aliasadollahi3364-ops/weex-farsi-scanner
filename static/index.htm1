from pathlib import Path

from fastapi import FastAPI
from fastapi.responses import HTMLResponse, JSONResponse

app = FastAPI(title="WEEX Farsi Scanner")

BASE_DIR = Path(__file__).resolve().parent
INDEX_FILE = BASE_DIR / "static" / "index.html"


@app.get("/", response_class=HTMLResponse)
def home():
    if not INDEX_FILE.is_file():
        return HTMLResponse(
            content="""
            <html lang="fa" dir="rtl">
            <meta charset="utf-8">
            <title>خطای اسکنر</title>
            <body style="font-family: sans-serif; padding: 30px">
                <h2>فایل صفحه اصلی پیدا نشد!</h2>
                <p>بررسی کن فایل index.html داخل پوشه static باشد.</p>
            </body>
            </html>
            """,
            status_code=500,
        )

    return HTMLResponse(
        content=INDEX_FILE.read_text(encoding="utf-8")
    )


@app.get("/health")
def health():
    return {
        "status": "ok",
        "message": "WEEX Farsi Scanner is running",
        "index_file_exists": INDEX_FILE.is_file(),
    }


@app.get("/favicon.ico")
def favicon():
    return JSONResponse({}, status_code=204)
